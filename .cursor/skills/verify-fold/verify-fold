#!/usr/bin/env bash
# Isolated Fold instance for verification. Never uses the dev database
# named "fold" or the shared make-e2e database.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
COMPOSE=(docker compose -f "$ROOT/deploy/docker-compose.dev.yml")
ADMIN_DB=fold
# VERIFY_PG_URL points at an already-running Postgres when there is no
# Docker (any database the role may CREATE DATABASE from). Unset, the dev
# compose database is used.
DEV_DATABASE_URL="${VERIFY_PG_URL:-postgres://fold:fold@127.0.0.1:5432/${ADMIN_DB}?sslmode=disable}"

# url_for DB prints DEV_DATABASE_URL pointed at database DB.
url_for() {
  local base="${DEV_DATABASE_URL%%\?*}" query=""
  [[ "$DEV_DATABASE_URL" == *\?* ]] && query="?${DEV_DATABASE_URL#*\?}"
  printf '%s/%s%s\n' "${base%/*}" "$1" "$query"
}

die() { printf 'verify-fold: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage: verify-fold up
       verify-fold doctor RUN_ID
       verify-fold env RUN_ID
       verify-fold drive RUN_ID sign-in
       verify-fold down RUN_ID

up starts a new Fold process on its own Postgres database and port.
doctor checks that process. drive sign-in runs the sign-in proof.
down stops that process and drops its database. Proof files under
/tmp/fold-verify-proof/RUN_ID are left in place.
EOF
}

work_dir() { printf '/tmp/fold-verify-%s\n' "$1"; }
proof_dir() { printf '/tmp/fold-verify-proof/%s\n' "$1"; }

db_name_ok() {
  [[ "$1" =~ ^fold_verify_[a-z0-9_]+$ ]]
}

psql_admin() {
  if [[ -n "${VERIFY_PG_URL:-}" ]]; then
    psql "$VERIFY_PG_URL" -v ON_ERROR_STOP=1 "$@"
  else
    "${COMPOSE[@]}" exec -T db psql -U fold -d "$ADMIN_DB" -v ON_ERROR_STOP=1 "$@"
  fi
}

psql_named() {
  local db="$1"
  shift
  db_name_ok "$db" || die "refusing to query database $db"
  if [[ -n "${VERIFY_PG_URL:-}" ]]; then
    psql "$(url_for "$db")" -v ON_ERROR_STOP=1 "$@"
  else
    "${COMPOSE[@]}" exec -T db psql -U fold -d "$db" -v ON_ERROR_STOP=1 "$@"
  fi
}

ensure_db() {
  if [[ -n "${VERIFY_PG_URL:-}" ]]; then
    psql_admin -tAc 'SELECT 1' >/dev/null || die "cannot reach VERIFY_PG_URL"
  else
    "${COMPOSE[@]}" up -d --wait db
  fi
}

load_state() {
  local run="$1"
  STATE="$(work_dir "$run")/state.env"
  [[ -f "$STATE" ]] || die "no state for $run at $STATE"
  # shellcheck disable=SC1090
  source "$STATE"
  [[ "$RUN_ID" == "$run" ]] || die "state RUN_ID does not match $run"
  db_name_ok "$DB_NAME" || die "state database name is not a verify database"
}

# port_owned_by PID PORT succeeds when PID owns the listening socket.
port_owned_by() {
  ss -Hltnp "sport = :$2" 2>/dev/null | grep -q "pid=$1," && echo yes
}

# free_port prints an unused TCP port on 127.0.0.1.
free_port() {
  local p
  for _ in $(seq 1 50); do
    p=$(( (RANDOM % 20000) + 30000 ))
    ss -Hltn "sport = :$p" | grep -q . || { echo "$p"; return 0; }
  done
  die "no free port"
}

cmd_up() {
  ensure_db
  local run db port secret work evidence base url
  run="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  db="fold_verify_$(printf '%s' "$run" | tr 'A-Z-' 'a-z_')"
  db_name_ok "$db" || die "bad database name $db"
  work="$(work_dir "$run")"
  evidence="$(proof_dir "$run")"
  mkdir -p "$work/uploads" "$evidence"
  port="$(free_port)"
  secret="verify-only-session-secret-0123456789abcdef"
  url="$(url_for "$db")"
  psql_admin -c "CREATE DATABASE \"${db}\""
  printf 'building the SPA and the fold binary\n' >&2
  (cd "$ROOT/web" && npm run build)
  CGO_ENABLED=0 go build -C "$ROOT" -o "$work/fold" .
  cat >"$work/state.env" <<EOF
RUN_ID=$run
PORT=$port
URL=http://127.0.0.1:$port
PID=
DATABASE_URL=$url
DB_NAME=$db
WORK=$work
EVIDENCE=$evidence
BINARY=$work/fold
DEV_DATABASE_URL=$DEV_DATABASE_URL
EOF
  (
    cd "$ROOT"
    export APP_ENV=prod PORT="$port" DATABASE_URL="$url" \
      SESSION_SECRET="$secret" COOKIE_SECURE=false UPLOAD_DIR="$work/uploads"
    exec setsid "$work/fold" serve
  ) >>"$work/server.log" 2>&1 &
  local pid=$!
  printf 'PID=%s\n' "$pid" >>"$work/state.env"
  local i
  for i in $(seq 1 60); do
    if curl -sf -o /dev/null "http://127.0.0.1:${port}/healthz"; then
      printf 'RUN_ID=%s\nURL=http://127.0.0.1:%s\nEVIDENCE=%s\n' "$run" "$port" "$evidence"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      printf 'server exited; log follows\n' >&2
      tail -n 40 "$work/server.log" >&2 || true
      die "server exited before /healthz answered"
    fi
    sleep 0.5
  done
  tail -n 40 "$work/server.log" >&2 || true
  die "timed out waiting for /healthz on port $port"
}

cmd_doctor() {
  local run="$1"
  load_state "$run"
  [[ -n "${PID:-}" ]] || die "state has no PID"
  kill -0 "$PID" || die "pid $PID is not running"
  local exe
  exe="$(readlink -f "/proc/$PID/exe")"
  [[ "$exe" == "$BINARY" ]] || die "pid $PID is $exe, not $BINARY"
  local cmd
  cmd="$(tr '\0' ' ' <"/proc/$PID/cmdline")"
  [[ "$cmd" == *"serve"* ]] || die "pid $PID command is not serve: $cmd"
  port_owned_by "$PID" "$PORT" >/dev/null || die "pid $PID does not listen on port $PORT"
  local live_url
  live_url="$(tr '\0' '\n' <"/proc/$PID/environ" | sed -n 's/^DATABASE_URL=//p')"
  [[ "$live_url" == "$DATABASE_URL" ]] || die "process DATABASE_URL does not match state"
  [[ "$live_url" == *"/${DB_NAME}?"* ]] || die "process is not using $DB_NAME"
  [[ "$DB_NAME" != "fold" && "$DB_NAME" != *"_e2e" ]] || die "refusing shared database $DB_NAME"
  local code body
  body="$(mktemp)"
  code="$(curl -sS -o "$body" -w '%{http_code}' "http://127.0.0.1:${PORT}/healthz")"
  [[ "$code" == "200" ]] || die "healthz returned $code"
  [[ ! -s "$body" ]] || die "healthz body was not empty"
  rm -f "$body"
  local version
  version="$("$BINARY" version)"
  [[ "$version" == fold\ * ]] || die "unexpected version: $version"
  printf 'ok\nrun %s\npid %s\nurl %s\ndatabase %s\nversion %s\nhealthz 200 empty\nport owned by pid\n' \
    "$RUN_ID" "$PID" "$URL" "$DB_NAME" "$version"
}

cmd_env() {
  local run="$1"
  load_state "$run"
  printf 'export VERIFY_URL=%q VERIFY_EVIDENCE=%q VERIFY_DATABASE_URL=%q VERIFY_DEV_DATABASE_URL=%q VERIFY_RUN_ID=%q FOLD_ROOT=%q\n' \
    "$URL" "$EVIDENCE" "$DATABASE_URL" "$DEV_DATABASE_URL" "$RUN_ID" "$ROOT"
}

cmd_drive() {
  local run="$1" feature="$2"
  load_state "$run"
  [[ "$feature" == "sign-in" ]] || die "only the sign-in drive is packaged; other features are in features/"
  cmd_doctor "$run" >/dev/null
  mkdir -p "$EVIDENCE/sign-in"
  local node_path="$ROOT/web/node_modules"
  local script="$ROOT/.cursor/skills/verify-fold/drive-sign-in.mjs"
  local log="$EVIDENCE/sign-in/drive.log"
  if ! VERIFY_URL="$URL" VERIFY_EVIDENCE="$EVIDENCE" VERIFY_DATABASE_URL="$DATABASE_URL" \
    NODE_PATH="$node_path" node "$script" >"$log" 2>&1; then
    if grep -q "Executable doesn't exist" "$log"; then
      (cd "$ROOT/web" && npx playwright install chromium)
      if ! VERIFY_URL="$URL" VERIFY_EVIDENCE="$EVIDENCE" VERIFY_DATABASE_URL="$DATABASE_URL" \
        NODE_PATH="$node_path" node "$script" >"$log" 2>&1; then
        cat "$log" >&2
        exit 1
      fi
    else
      cat "$log" >&2
      exit 1
    fi
  fi
  psql_named "$DB_NAME" -c "COPY (SELECT email, name, role FROM users ORDER BY id) TO STDOUT WITH CSV HEADER" \
    >"$EVIDENCE/sign-in/users.csv"
  grep -q 'verify-admin@example.com,Verify Admin,admin' "$EVIDENCE/sign-in/users.csv" \
    || die "verify database is missing the admin row"
  local leaked
  leaked="$(psql_admin -tA -c "SELECT count(*) FROM users WHERE email = 'verify-admin@example.com'" 2>/dev/null || true)"
  leaked="$(printf '%s' "$leaked" | tr -d '[:space:]')"
  if [[ -n "$leaked" && "$leaked" != "0" ]]; then
    die "dev database fold contains the verify user"
  fi
  printf 'drove sign-in\nevidence %s/sign-in\n' "$EVIDENCE"
}

stop_pid() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null || return 0
  kill -TERM "$pid" 2>/dev/null || true
  local i
  for i in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.25
  done
  kill -KILL "$pid" 2>/dev/null || true
}

cmd_down() {
  local run="$1"
  local work evidence
  work="$(work_dir "$run")"
  evidence="$(proof_dir "$run")"
  if [[ -f "$work/state.env" ]]; then
    # shellcheck disable=SC1090
    source "$work/state.env"
    if [[ -n "${PID:-}" ]]; then
      stop_pid "$PID"
    fi
    if [[ -n "${DB_NAME:-}" ]]; then
      db_name_ok "$DB_NAME" || die "refusing to drop $DB_NAME"
      psql_admin -c "DROP DATABASE IF EXISTS \"${DB_NAME}\" WITH (FORCE)"
    fi
  fi
  rm -rf "$work"
  [[ "$work" != "$evidence" ]] || die "refusing to remove proof directory"
  if [[ -d "$evidence" ]]; then
    printf 'stopped %s\nproof kept at %s\n' "$run" "$evidence"
  else
    printf 'stopped %s\nno proof directory\n' "$run"
  fi
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    up) cmd_up ;;
    doctor) [[ $# -eq 2 ]] || die "doctor needs RUN_ID"; cmd_doctor "$2" ;;
    env) [[ $# -eq 2 ]] || die "env needs RUN_ID"; cmd_env "$2" ;;
    drive) [[ $# -eq 3 ]] || die "drive needs RUN_ID and a feature"; cmd_drive "$2" "$3" ;;
    down) [[ $# -eq 2 ]] || die "down needs RUN_ID"; cmd_down "$2" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command $cmd" ;;
  esac
}

main "$@"
