# Copy to /opt/fold/backup.env and chmod 600.
# provision.sh never creates the bucket or the key. Do that in the church's
# account (Spaces, Backblaze B2, or any other S3-compatible store), then
# fill this file. Leave the file absent to keep dumps only on the droplet.
#
# Generate the age key on a machine that is not the server:
#   age-keygen -o fold-backup.key
# Put the public key below. Store fold-backup.key in the church password
# manager. The private key must not be copied to the droplet.

FOLD_BACKUP_S3_BUCKET=example-fold-backups
FOLD_BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
FOLD_BACKUP_S3_REGION=nyc3
AWS_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET
FOLD_BACKUP_AGE_RECIPIENT=age1dryrunexamplepublickeyxxxxxxxxxxxxxxxxxx
FOLD_BACKUP_KEEP_DAYS=14
