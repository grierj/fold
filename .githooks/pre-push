#!/bin/sh
# Work reaches master through a pull request, never a direct push
# (the M1.7 push, Oct 2026: a feature branch tracking origin/master
# pushed straight to master under push.default=tracking).
# Activate once per clone: git config core.hooksPath .githooks
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/master | refs/heads/main)
		echo "pre-push: refusing a direct push to $remote_ref." >&2
		echo "Push your branch and open a pull request instead:" >&2
		echo "  git push origin HEAD:refs/heads/<your-branch>" >&2
		echo "If a direct push really is intended, use git push --no-verify." >&2
		exit 1
		;;
	esac
done
exit 0
