# Copy to .env and fill in. Generate the session secret with:
#   openssl rand -base64 32

# Public domain (or localhost for local testing). Caddy provisions TLS automatically.
DOMAIN=groups.example.org

# Signs session cookies and derives the CSRF key. Keep it secret.
SESSION_SECRET=

# Optional shared first-run setup code for multiple app processes. Generate
# with `openssl rand -hex 32`. When unset, Fold prints a new code on startup.
# FOLD_SETUP_TOKEN=

# Postgres password for the compose-managed database.
DB_PASSWORD=

# The Fold release Compose pulls (ghcr.io/grierj/fold:<FOLD_VERSION>). Pin an
# exact release such as 0.5.0 and change it only when you mean to upgrade;
# never use "latest". Compose refuses to start while this is empty. Until the
# first release is published, build from source instead with any label, e.g.
# FOLD_VERSION=dev, and docker-compose.build.yml (see the README).
FOLD_VERSION=

# Where user-uploaded assets (avatars, group covers) are stored.
# Compose mounts the named volume "uploads" at /data and the image
# sets UPLOAD_DIR=/data/uploads. Override this only for local dev.
# UPLOAD_DIR=./data/uploads

# Reverse proxies allowed to set X-Forwarded-For (comma-separated CIDRs or
# IPs). The default is the compose network's fixed subnet, where Caddy runs.
# A /0 range (0.0.0.0/0 or ::/0) trusts every sender, so Fold refuses to start
# with one, in dev too.
# FOLD_TRUSTED_PROXIES=172.30.0.0/24

# Compose sets SITE_URL=https://$DOMAIN and COOKIE_SECURE=true for you. Outside
# APP_ENV=dev Fold refuses to start with a SITE_URL that is not an https URL
# with a host, or with COOKIE_SECURE=false; plain-HTTP testing belongs in
# APP_ENV=dev.

# Transactional email (M1.2, C6): the minimal SMTP sender. smtp:// uses
# required STARTTLS outside localhost, smtps:// implicit TLS, e.g.
# FOLD_SMTP_URL=smtp://user:pass@smtp.example.org:587
# Unset in dev: mail is stored in the devoutbox and shown at /dev/outbox
# (APP_ENV=dev only). Unset in prod: the server logs a warning and every
# email send fails loudly instead of silently dropping password resets.
# FOLD_SMTP_URL=
# Trusted plaintext relay only: opt out of required STARTTLS (default false).
# This exposes email links on the network. It does not bypass TLS verification.
# Loopback relays may use plaintext without this setting. Remote relays using
# username/password authentication still require encryption.
# FOLD_SMTP_ALLOW_INSECURE=false
# From address on transactional email.
# FOLD_EMAIL_FROM=Fold <noreply@example.org>

# Background jobs (M3.1): workers in this process (0 turns them off, for
# debugging only; other processes' workers still run the jobs) and how often
# an idle worker looks for due work.
# FOLD_WORKERS=2
# FOLD_JOB_POLL=1s

# Email provider (M3.2): devoutbox (dev), smtp or postmark. Unset: devoutbox
# in dev, else postmark when FOLD_POSTMARK_SERVER_TOKEN is set, else smtp
# when FOLD_SMTP_URL is set.
# FOLD_EMAIL_PROVIDER=
# Postmark (the default, DEC-21): the server's API token, and its message
# streams for account mail and announcements.
# FOLD_POSTMARK_SERVER_TOKEN=
# FOLD_POSTMARK_TRANSACTIONAL_STREAM=outbound
# FOLD_POSTMARK_BROADCAST_STREAM=broadcast
# Postmark's delivery reports (M3.2b): at least 24 characters, letters and
# digits only (`openssl rand -hex 24`). In Postmark,
# add a webhook for Delivery, Bounce and Spam Complaint with the URL
# https://postmark:<this secret>@<your domain>/hooks/postmark/email
# Unset, the endpoint answers 404.
# FOLD_POSTMARK_WEBHOOK_SECRET=

# Web push: nothing to set. Fold makes its own keys on first boot and sends
# only to the browsers' push services (Google, Mozilla, Apple, Microsoft).
# The keys are locked with SESSION_SECRET: every app container on one
# database must share the same SESSION_SECRET; changing it turns off
# notifications on everyone's devices.
#
# Optional, additive: extra push service hosts for a
# browser that uses another one, comma-separated host names (no scheme or
# port). Subdomains of each host are included. `fold push check` shows which
# push services this server can reach.
# FOLD_PUSH_HOSTS=

# Backups (M5.2): the fold-backup service in Compose backs up the database and
# the uploads every night at 02:30 and keeps them locally. Nothing here is
# required; the defaults work. See deploy/backup/README.md.
#
# Zone for the 02:30 slot, archive names and the day-1 retention rule. An IANA
# zone name such as America/Denver; the default is UTC, and "Local" is refused.
# FOLD_BACKUP_TZ=UTC
# Days to keep daily archives, 1 to 365 (default 14). Archives named for the
# 1st of a month are kept 180 days. These are local rules only.
# FOLD_BACKUP_KEEP_DAYS=14
#
# The fold-backup image Compose pulls (ghcr.io/grierj/fold-backup:<version>).
# It defaults to FOLD_VERSION. Set it yourself when an older app release has
# no matching backup image; clear it when upgrading to a paired release.
# FOLD_BACKUP_VERSION=
# Set by deploy/digitalocean/provision.sh to the deployment directory so a
# restore and a backup never overlap. Leave it alone; unset, the service runs
# without that coordination.
# FOLD_BACKUP_COORD=
#
# FOLD_BACKUP_DIR is set by docker-compose.yml to /backup-status, the read-only
# folder where the backup service leaves LAST_OK and status.json. The app reads
# only those two files, shows them on Admin > System, and warns when the last
# backup is more than 36 hours old. It must be an absolute path; unset, nothing
# is watched. `fold backup status` reads the same folder from a shell.
#
# Optional encrypted offsite copies to an S3-compatible bucket. Set all six or
# none: a partial set makes every backup fail before it dumps anything. Each
# archive is encrypted with age to the public recipient below before it leaves
# the machine. Keep the matching private key (the AGE-SECRET-KEY file) offline,
# off this server and out of this file; you need it to read an offsite copy.
# Fold never deletes offsite copies: set an expiry rule on the bucket.
# Recommended providers and their endpoints (check your provider's page):
#   Backblaze B2: FOLD_BACKUP_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#                 (for example https://s3.us-east-005.backblazeb2.com, with
#                 FOLD_BACKUP_S3_REGION=us-east-005)
#   Cloudflare R2: FOLD_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                 with FOLD_BACKUP_S3_REGION=auto
# FOLD_BACKUP_S3_BUCKET=
# FOLD_BACKUP_S3_ENDPOINT=
# FOLD_BACKUP_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FOLD_BACKUP_AGE_RECIPIENT=age1...
