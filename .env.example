# Copy to .env and fill in. Generate the session secret with:
#   openssl rand -base64 32

# Public domain (or localhost for local testing). Caddy provisions TLS automatically.
DOMAIN=groups.example.org

# Signs session cookies and derives the CSRF key. Keep it secret.
SESSION_SECRET=

# Postgres password for the compose-managed database.
DB_PASSWORD=

# Where user-uploaded assets (avatars, group covers) are stored.
# Compose mounts the named volume "uploads" at /data and the image
# sets UPLOAD_DIR=/data/uploads. Override this only for local dev.
# UPLOAD_DIR=./data/uploads

# Reverse proxies allowed to set X-Forwarded-For (comma-separated CIDRs or
# IPs). The default is the compose network's fixed subnet, where Caddy runs.
# FOLD_TRUSTED_PROXIES=172.30.0.0/24

# Transactional email (M1.2, C6): the minimal SMTP sender. smtp:// uses
# required STARTTLS outside localhost, smtps:// implicit TLS, e.g.
# FOLD_SMTP_URL=smtp://user:pass@smtp.example.org:587
# Unset in dev: mail is stored in the devoutbox and shown at /dev/outbox
# (APP_ENV=dev only). Unset in prod: the server logs a warning and every
# email send fails loudly instead of silently dropping password resets.
# FOLD_SMTP_URL=
# Trusted plaintext relay only: opt out of required STARTTLS (default false).
# This exposes email links on the network. It does not bypass TLS verification.
# Loopback relays may use plaintext without this setting. Remote relays using
# username/password authentication still require encryption.
# FOLD_SMTP_ALLOW_INSECURE=false
# From address on transactional email.
# FOLD_EMAIL_FROM=Fold <noreply@example.org>

# Background jobs (M3.1): workers in this process (0 turns them off, for
# debugging only; other processes' workers still run the jobs) and how often
# an idle worker looks for due work.
# FOLD_WORKERS=2
# FOLD_JOB_POLL=1s

# Email provider (M3.2): devoutbox (dev), smtp or postmark. Unset: devoutbox
# in dev, else postmark when FOLD_POSTMARK_SERVER_TOKEN is set, else smtp
# when FOLD_SMTP_URL is set.
# FOLD_EMAIL_PROVIDER=
# Postmark (the default, DEC-21): the server's API token, and its message
# streams for account mail and announcements.
# FOLD_POSTMARK_SERVER_TOKEN=
# FOLD_POSTMARK_TRANSACTIONAL_STREAM=outbound
# FOLD_POSTMARK_BROADCAST_STREAM=broadcast
# Postmark's delivery reports (M3.2b): at least 24 characters, letters and
# digits only (`openssl rand -hex 24`). In Postmark,
# add a webhook for Delivery, Bounce and Spam Complaint with the URL
# https://postmark:<this secret>@<your domain>/hooks/postmark/email
# Unset, the endpoint answers 404.
# FOLD_POSTMARK_WEBHOOK_SECRET=

# Web push: nothing to set. Fold makes its own keys on first boot and sends
# only to the browsers' push services (Google, Mozilla, Apple, Microsoft).
# The keys are locked with SESSION_SECRET: every app container on one
# database must share the same SESSION_SECRET; changing it turns off
# notifications on everyone's devices. Optional, additive: extra push service hosts for a
# browser that uses another one, comma-separated host names (no scheme or
# port). Subdomains of each host are included. `fold push check` shows which
# push services this server can reach.
# FOLD_PUSH_HOSTS=
