# Copy to .env and fill in. Generate the session secret with:
#   openssl rand -base64 32

# Public domain (or localhost for local testing). Caddy provisions TLS automatically.
DOMAIN=groups.example.org

# Signs session cookies and derives the CSRF key. Keep it secret.
SESSION_SECRET=

# Postgres password for the compose-managed database.
DB_PASSWORD=

# Where user-uploaded assets (avatars, group covers) are stored.
# Compose mounts the named volume "uploads" at /data and the image
# sets UPLOAD_DIR=/data/uploads. Override this only for local dev.
# UPLOAD_DIR=./data/uploads

# Reverse proxies allowed to set X-Forwarded-For (comma-separated CIDRs or
# IPs). The default is the compose network's fixed subnet, where Caddy runs.
# FOLD_TRUSTED_PROXIES=172.30.0.0/24

# Transactional email (M1.2, C6): the minimal SMTP sender. smtp:// uses
# opportunistic STARTTLS, smtps:// implicit TLS, e.g.
# FOLD_SMTP_URL=smtp://user:pass@smtp.example.org:587
# Unset in dev: mail is stored in the devoutbox and shown at /dev/outbox
# (APP_ENV=dev only). Unset in prod: the server logs a warning and every
# email send fails loudly instead of silently dropping password resets.
# FOLD_SMTP_URL=
# From address on transactional email.
# FOLD_EMAIL_FROM=Fold <noreply@example.org>
