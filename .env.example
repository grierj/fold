# Copy this file to .env and fill it in (docs/INSTALL.md).

# The site's address, without https://. Point its DNS A record at this server first.
DOMAIN=church.example.org

# The release to run, an exact version such as 0.2.0. Never "latest".
VERSION=0.2.0

# The server's secret. Make it once with:  openssl rand -hex 32
# Keep a copy somewhere safe (a password manager): without it the saved mail
# settings cannot be read after moving to a new server.
SECRET_KEY=

# Only while changing the secret: the old one. See docs/OPERATIONS.md.
SECRET_KEY_PREVIOUS=
